# Dynamically generate docker-compose.yml to launch multiple Nginx instances

version: "3.9"

services:
{% for i in range(nginx_server_count) %}
  nginx_server_{{ i }}:
    image: nginx:latest
    container_name: nginx_server_{{ i }}
    volumes:
      - ./nginx_conf_{{ i }}.conf:/etc/nginx/conf.d/default.conf
    ports:
      - "{{ 9000 + i }}:80"
    networks:
      - common_network
    restart: always
{% endfor %}

# Docker compose attach the container to the network but doesn't create it.
networks:
  common_network:
    external: true